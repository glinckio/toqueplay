{
  "expo": {
    "name": "ToquePlay",
    "slug": "toqueplay",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "toqueplay",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.toqueplay.app"
    },
    "android": {
      "package": "com.toqueplay.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C0A12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir que o ToquePlay acesse sua localização para encontrar torneios próximos.",
          "locationWhenInUsePermission": "Permitir que o ToquePlay acesse sua localização para encontrar torneios próximos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que o ToquePlay acesse suas fotos para definir foto de perfil e banners.",
          "cameraPermission": "Permitir que o ToquePlay use a câmera para tirar fotos."
        }
      ],
      "expo-image",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "62fdd475-a2dd-4d2f-b4e7-76aaface9346"
      }
    },
    "owner": "gabriellinck"
  }
}
